# Pilih provider AI: "gemini" | "deepseek" | "cloudflare_gateway" | "workers_ai"
AI_PROVIDER=workers_ai
WORKERS_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

# Google Gemini API (Bisa isi 1 key atau beberapa key dipisah koma untuk failover otomatis: key1,key2,key3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# DeepSeek API (Dapatkan di https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Cloudflare AI Gateway (Opsional)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=kamuslengkap

# Server VPS DigitalOcean tempat web lama (PHP) berjalan
ORIGIN_VPS_HOST=https://kamuslengkap.com
