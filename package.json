{
  "name": "kamuslengkap",
  "version": "1.0.0",
  "description": "KamusLengkap AI - Edge Lexicon with Multi-Engine AI and Cloudflare D1",
  "main": "src/index.tsx",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy",
    "d1:init": "wrangler d1 execute kamuslengkap-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute kamuslengkap-db --remote --file=./schema.sql"
  },
  "keywords": [
    "dictionary",
    "kamus",
    "ai",
    "cloudflare-workers",
    "hono",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
